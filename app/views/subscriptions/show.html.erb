<%= link_to 'Вернуться на страницу профиля', user_path(@user) %>
<h1> Подписчики <%= @user.nickname %></h1>

<ul>
  <% @followers.each do |follower| %>
    <li>
    
      <%= link_to follower.name, user_path(follower) %>
      <% if current_user == @user  %>
        <%= button_to 'Отписать', user_subscription_path(Subscription.find_by(follower_id: follower.id, followed_id: current_user.id).id), method: :delete, data: { confirm: "Вы действительно хотите отписать #{follower.name}?" } %>
      <% end %>
    </li>
  <% end %>
</ul>
